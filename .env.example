# Copy to .env and set a password BEFORE the first start (8+ characters). Cinestellar won't
# start without one. It protects the bundled Neo4j database, which is never exposed outside Docker.
NEO4J_PASSWORD=

# Port the site is served on.
APP_PORT=8080

# Optional: pin a version instead of following the latest release (e.g. 0.8.0).
CINESTELLAR_TAG=latest

# Optional: memory for the bundled Neo4j (1G suits most libraries; 512M for small machines).
NEO4J_HEAP=1G

# Optional: ask for this password before showing the site (recommended unless your LAN is private).
APP_PASSWORD=

# Optional: extra hostnames you open the site by, comma-separated (e.g. cinestellar.example.com).
# IP addresses, localhost, single-word computer names and *.local / *.lan always work.
ALLOWED_HOSTS=

# Optional: how many cast members per movie to import (top-billed first).
MAX_CAST=30

# Optional: titles fetched from Plex per request (verified automatically; 1 turns combining off).
PLEX_FETCH_BATCH=10

# Optional: studio logos, and franchises for movies Plex hasn't put in a collection. Both come
# from The Movie Database (Plex has no studio pictures).
# Easiest: paste the key in the site under Libraries -> Studio logos and franchises (TMDB).
# Or set it here: get a free key at https://www.themoviedb.org/settings/api (either the
# "API Key" or the longer "API Read Access Token" works), restart, and run the import again.
# Only studio names and TMDB movie ids are sent to TMDB.
TMDB_API_KEY=
